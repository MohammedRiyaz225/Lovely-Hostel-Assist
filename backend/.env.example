# HostelFix Backend Environment Variables
# Copy this file to .env and fill in your real values

# MongoDB Atlas
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hostelfix?retryWrites=true&w=majority

# JWT
JWT_SECRET_KEY=change_this_to_a_long_random_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# Firebase (for FCM push notifications)
# Download serviceAccountKey.json from Firebase Console > Project Settings > Service Accounts
FIREBASE_CREDENTIALS_PATH=firebase_service_account.json
